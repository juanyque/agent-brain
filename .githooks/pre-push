#!/bin/sh
# push-gate pre-push hook (dogfooding: calls this repo's own copy)
# git passes the remote name and url as arguments (ignored) and one
# "<local_ref> <local_sha> <remote_ref> <remote_sha>" line per pushed
# ref on stdin; deleted refs (all-zero local sha) have nothing to audit.
# A brand-new remote ref is audited from the empty tree (full history).
GATE="$(git rev-parse --show-toplevel)/skills/push-gate/scripts/pre_push_audit.py"
REPO_ROOT="$(git rev-parse --show-toplevel)"
# The gate needs Python 3.10+; a bare `python3` may be an older pyenv shim.
PYTHON=""
for candidate in python3.13 python3.12 python3.11 python3.10 python3; do
    if command -v "$candidate" >/dev/null 2>&1 \
        && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
        PYTHON="$candidate"
        break
    fi
done
if [ -z "$PYTHON" ]; then
    echo "push-gate: Python 3.10+ not found; refusing to push unaudited." >&2
    exit 1
fi
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        ''|*[!0]*) ;;
        *) continue ;;
    esac
    "$PYTHON" "$GATE" --repo-root "$REPO_ROOT" \
        --range "$remote_sha..$local_sha" || status=1
done
exit "$status"
